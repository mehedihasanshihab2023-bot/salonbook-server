# ---- Server ----
PORT=5000
NODE_ENV=development

# Public URL of this API (used by Better Auth)
SERVER_URL=http://localhost:5000
# Public URL of the Next.js client (CORS + Stripe redirect targets)
CLIENT_URL=http://localhost:3000

# ---- Database ----
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/salonbook
# Set to 1 to use a throw-away in-memory database (local demos only)
USE_MEMORY_DB=0

# ---- Auth secrets ----
BETTER_AUTH_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-another-long-random-string

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---- ImgBB ----
IMGBB_API_KEY=replace-me

# ---- Admin bootstrap (optional, used by npm run create-admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
